rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sayankumarpatra2006@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // Public Question Bank Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private Student Profiles: strict owner-only access, forbid password fields
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == studentId && !('password' in incoming());
      allow update: if isOwner(studentId) && !('password' in incoming());
      allow delete: if isAdmin();
    }

    // Student Orders: only owner student or admin can inspect orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().studentId == request.auth.uid ||
        incoming().userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }
  }
}
